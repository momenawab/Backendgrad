# Copy to .env on the server and fill in real values. Never commit the real .env.
# The systemd unit (deploy/safesight.service) loads this file.

# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
# Comma-separated; include your domain and/or EC2 public DNS.
ALLOWED_HOSTS=your.domain.com,ec2-1-2-3-4.compute.amazonaws.com,127.0.0.1
# Used for admin login / CSRF over HTTPS.
CSRF_TRUSTED_ORIGINS=https://your.domain.com

# Database — RDS Postgres connection string.
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://safesight:password@your-db.xxxxx.us-east-1.rds.amazonaws.com:5432/safesight

# Optional: only for a Flutter Web build (mobile apps don't need CORS).
# CORS_ALLOWED_ORIGINS=https://yourwebapp.com
